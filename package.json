{
  "name": "realtime-infinite-canvas",
  "version": "0.0.1",
  "description": "Realtime collaborative infinite canvas",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint --ext .ts,.tsx . --ignore-path .gitignore",
    "format": "prettier --write --ignore-path .gitignore .",
    "dev": "npm run dev --workspaces --if-present",
    "dev:all": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "install:all": "npm install && npm install --workspaces",
    "validate:phase4:harness": "node docs/validation/harness/run-phase4-validation.mjs",
    "validate:phase4:gates": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
