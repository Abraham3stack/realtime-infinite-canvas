# Local Docker PostgreSQL settings
POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas
POSTGRES_DB=realtime_canvas
POSTGRES_PORT=5432

# Backend service settings
SERVER_PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Database URL used by the server container in docker-compose
DATABASE_URL_DOCKER=postgresql://canvas:canvas@postgres:5432/realtime_canvas?schema=public

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=realtime-infinite-canvas

# Upload limits (bytes)
UPLOAD_MAX_FILES=10
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_AUDIO_BYTES=20971520
UPLOAD_MAX_VIDEO_BYTES=83886080