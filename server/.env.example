# Local Docker PostgreSQL connection string
# Default matches docker-compose service values.
DATABASE_URL="postgresql://canvas:canvas@localhost:5432/realtime_canvas?schema=public"

# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=realtime-infinite-canvas

# Upload limits (bytes)
UPLOAD_MAX_FILES=10
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_AUDIO_BYTES=20971520
UPLOAD_MAX_VIDEO_BYTES=83886080
