# Neon PostgreSQL connection string
# Obtain from: Neon Console → your project → Connection Details → Connection string
# Use the "pooled" connection string (port 5432 variant) for better connection management
# under serverless / long-running server workloads.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
